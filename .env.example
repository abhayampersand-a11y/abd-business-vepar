# Neon Postgres
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# Google sign-in (optional — the email/password login works without it).
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# and register this exact redirect URI:  <your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Canonical origin, e.g. https://your-app.vercel.app — needed so the OAuth
# redirect URI matches the one registered with Google. Leave unset locally.
APP_URL=""

# Address printed into item QR labels, e.g. https://your-app.vercel.app — only needed
# when labels are printed from an address phones can't open (localhost, a LAN IP).
NEXT_PUBLIC_APP_URL=""
